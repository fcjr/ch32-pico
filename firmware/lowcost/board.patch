@@ -119,11 +121,17 @@
 				}
 				case 0x02: // Power-down 
 					printf( "Power down\n" );
+					// Release both tied SWIO pins before removing target power.
+					funPinMode( PIN_SWD_IN, GPIO_CFGLR_IN_FLOAT );
+					funPinMode( PIN_SWD_OUT, GPIO_CFGLR_IN_FLOAT );
 					funDigitalWrite( PIN_TARGETPOWER, POWER_OFF );
