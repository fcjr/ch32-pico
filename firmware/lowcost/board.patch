-	usb_setup();
+
 
 	funGpioInitAll();
+	// PD2 drives a regulator CE input. It never supplies the target load.
+	funDigitalWrite( PIN_TARGETPOWER, POWER_ON );
+	funPinMode( PIN_TARGETPOWER, PIN_TARGETPOWER_MODE );
+	Delay_Ms(2);
+	funPinMode( PC6, GPIO_CFGLR_IN_FLOAT ); // External VBUS_N level translator.
+	funDigitalWrite( PD5, 0 );
+	funPinMode( PD5, GPIO_CFGLR_OUT_10Mhz_PP );
+	int usb_attached = 0;
 
 	ConfigureIOForRVSWIO();
