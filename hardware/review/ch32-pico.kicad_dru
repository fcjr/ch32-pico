(version 1)
# JLCPCB capabilities, checked 2026-10-11:
# https://jlcpcb.com/capabilities/pcb-capabilities
# Board floor: 0.20 mm drilled-hole/copper clearance for vias and NPTH.
# PTH: 0.30 mm also meets the stricter inner-layer requirement.
(rule "JLC plated pad drill to copper"
  (condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.30mm)))
(rule "JLC plated pad drill spacing"
  (condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
  (constraint hole_to_hole (min 0.45mm)))
